# Copiar a .env y completar solo en tu computadora. No subir credenciales a Git.
PORT=3000
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=tu_client_id
AUTH0_CLIENT_SECRET=
# Generar al menos 32 bytes aleatorios como 64 caracteres hexadecimales.
AUTH0_SESSION_SECRET=
AUTH0_CONNECTION=google-oauth2
# Opcional en local; obligatorio en Vercel. Usar redis:// o rediss://.
REDIS_URL=
