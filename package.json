{
  "name": "una-chat",
  "version": "1.0.0",
  "description": "UNA Chat (Socket.IO): Laboratorio 5 de Paradigmas de Programacion",
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "test:unit": "mocha",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:bdd": "cucumber-js",
    "test:e2e": "playwright test --project=chromium",
    "test:all": "node harness/scripts/run-suites.js",
    "harness": "node harness/bin/sdlc.js",
    "demo": "node harness/scripts/demo.js",
    "test:harness": "node --test \"harness/test/**/*.test.js\""
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "reporters": [
      "default"
    ],
    "testMatch": [
      "**/tests/integration/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
